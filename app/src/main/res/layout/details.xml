<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/RelativeLayout1"
    android:background="#75000000"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/top_bar"
        android:background="#20000000"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/shadow"
            android:background="@drawable/shadow_top"
            android:layout_width="match_parent"
            android:layout_height="12dp"/>
        <EditText
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:ellipsize="end"
            android:id="@+id/name"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_device_name"
            android:maxLines="1"
            android:lines="1"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:inputType="text"/>
        <View
            android:id="@+id/line3"
            android:background="#20ffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/name"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/RelativeLayout2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/detail_bar"
        android:layout_below="@+id/top_bar">
        <ExpandableListView
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <View
        android:id="@+id/view1"
        android:background="@drawable/shadow_bottom"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_above="@+id/detail_bar"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/detail_bar"
        android:background="@drawable/action_bar"
        android:paddingLeft="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Switch
            android:id="@+id/attach_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="grab"
            android:textOff="grab"/>
        <Switch
            android:id="@+id/kill_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="kill"
            android:textOff="kill"/>
        <TextView
            android:gravity="right"
            android:id="@+id/detail_ip"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/example_ip"
            android:shadowColor="#ff000000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"/>
    </LinearLayout>
    <View
        android:id="@+id/line"
        android:background="#60ffffff"
        android:layout_width="1dp"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/shadow_top"
        android:background="@drawable/shadow_top"
        android:layout_width="wrap_content"
        android:layout_height="16dp"/>
    <View
        android:id="@+id/shadow_left"
        android:background="@drawable/shadow_left"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"/>
</RelativeLayout>
