<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/RelativeLayout1"
    android:background="@drawable/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view4"
        android:background="#b0333333"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentTop="true"/>
    <View
        android:id="@+id/view3"
        android:background="@drawable/shadow_top"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_alignParentTop="true"/>
    <fragment
        android:name="me.paranoid.wifikill.fragment.DevicesFragment"
        android:id="@+id/device_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/status_bar"
        class="me.paranoid.wifikill.fragment.DevicesFragment"/>
    <View
        android:id="@+id/view1"
        android:background="@drawable/shadow_bottom"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_above="@+id/status_bar"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/view2"
        android:background="#20ffffff"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/status_bar"/>
    <ProgressBar
        android:id="@+id/search_progress"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        style="?android:attr/progressBarStyleHorizontal"/>
    <fragment
        android:name="me.paranoid.wifikill.fragment.StatusBarFragment"
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <View
        android:id="@+id/top_line"
        android:background="#ff222222"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</RelativeLayout>
